# Application
ENV=dev
DEBUG=false
APP_VERSION=2.0.0

# API
API_V1_PREFIX=/api/v1
# API_KEY=your-secret-api-key  # Uncomment to enable API key auth
RATE_LIMIT_PER_MINUTE=60

# LLM Configuration
LLM_MODEL_NAME=distilgpt2
LLM_MAX_LENGTH=150
LLM_TEMPERATURE=1.0
LLM_DEVICE=-1  # -1=CPU, 0+=GPU index

# Evaluation
RELEVANCE_MODEL_NAME=all-MiniLM-L6-v2
HALLUCINATION_RELEVANCE_THRESHOLD=0.3
TOXICITY_THRESHOLD=0.7

# MLflow
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=llm-monitoring

# Database
DATABASE_URL=sqlite:///./llm_monitor.db

# Prometheus
ENABLE_METRICS=true
